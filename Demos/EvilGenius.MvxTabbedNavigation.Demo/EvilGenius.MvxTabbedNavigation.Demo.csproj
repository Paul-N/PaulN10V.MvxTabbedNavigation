<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>EvilGenius.MvxTabbedNavigation.Demo</RootNamespace>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseMaui>true</UseMaui>
		<AndroidLinkMode>None</AndroidLinkMode>
<!--		<UseMauiEssentials>true</UseMauiEssentials>-->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<!-- Display name -->
		<ApplicationTitle>TabbedNavigation Demo</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.evilgenius.tabbednavigationdemo</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<!-- Ensure referenced assemblies are copied to the output for Android builds -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

<!--		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>-->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
<!--		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>-->

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<AndroidSdkCurrentVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36.0</AndroidSdkCurrentVersion>
		<AndroidMinSdkVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</AndroidMinSdkVersion>

		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">26.2</TargetPlatformVersion>
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36.0</TargetPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
	  <DefineConstants>$(DefineConstants)TRACE;SINGLE_PRJ</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
		<MauiIcon Include="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <MauiImage Remove="Resources\Images\dotnet_bot.svg" />
	</ItemGroup>

	<ItemGroup>
<!--		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />-->
		<PackageReference Include="MvvmCross" Version="10.1.2" />
		<PackageReference Include="MvvmCross.Plugin.Color" Version="10.1.2" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <!-- Ensure the demo references the correct TFM output of the library project when building each TFM -->
		<ProjectReference Include="..\..\EvilGenius.MvxTabbedNavigation\EvilGenius.MvxTabbedNavigation.csproj">
		<!-- Forward the current TargetFramework so the referenced project builds the matching TFM (e.g., net10.0-android) -->
		<TargetFramework>$(TargetFramework)</TargetFramework>
		<!-- Ensure the referenced project's runtime assembly is copied into the consuming project's output -->
		<Private>true</Private>
	  </ProjectReference>
	  <ProjectReference Include="..\EvilGenius.MvxTabbedNavigation.Demo.Core\EvilGenius.MvxTabbedNavigation.Demo.Core.csproj" />
	</ItemGroup>

	<!-- Fallback: when building Android, reference the compiled Android output of the library to ensure the assembly is available
		 to the Xamarin.Android linker/Java.Interop scanner. This is a pragmatic workaround to make sure ISingleHostActivity
		 is present in the Demo's assembly set during the LinkAssembliesNoShrink step. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
	  <Reference Include="EvilGenius.MvxTabbedNavigation">
		<HintPath>..\..\EvilGenius.MvxTabbedNavigation\bin\$(Configuration)\net10.0-android\EvilGenius.MvxTabbedNavigation.dll</HintPath>
		<Private>true</Private>
		<EmbedInteropTypes>false</EmbedInteropTypes>
	  </Reference>
	</ItemGroup>

  <!-- Ensure the library's Android-built assembly is present in the intermediate linker folders before the
	   Xamarin.Android LinkAssembliesNoShrink step so Java.Interop can resolve platform-specific types. -->
  <Target Name="CopyLibraryIntoLinkerPath" BeforeTargets="_LinkAssembliesNoShrink;LinkAssembliesNoShrink" Condition="'$(TargetFramework)' == 'net10.0-android'">
	<PropertyGroup>
	  <LibrarySourcePath>..\..\EvilGenius.MvxTabbedNavigation\bin\$(Configuration)\net10.0-android\EvilGenius.MvxTabbedNavigation.dll</LibrarySourcePath>
	  <LinkerDestDir>$(IntermediateOutputPath)lp\999\jl\</LinkerDestDir>
	</PropertyGroup>

	<Message Importance="high" Text="Copying library assembly for Java.Interop scanning: $(LibrarySourcePath) -> $(LinkerDestDir)" />

	<MakeDir Directories="$(LinkerDestDir)" />
	<Copy SourceFiles="$(LibrarySourcePath)" DestinationFolder="$(LinkerDestDir)" SkipUnchangedFiles="true" />
	<!-- Also copy to the intermediate output root so the assembly resolver can find it -->
	<Copy SourceFiles="$(LibrarySourcePath)" DestinationFolder="$(IntermediateOutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>
